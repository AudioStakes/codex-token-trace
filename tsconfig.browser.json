{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "dist/server-ui",
    "rootDir": "src/server-ui",
    "noEmitOnError": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": []
  },
  "exclude": ["dist", "node_modules", "codex_token_trace", "legacy-python"],
  "include": ["src/server-ui/overview-client.ts", "src/server-ui/single-session-client.ts"]
}
