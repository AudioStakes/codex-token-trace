{
  "name": "codex-token-trace",
  "version": "0.3.0",
  "description": "Trace what drives Codex token usage from local session logs.",
  "type": "module",
  "private": true,
  "bin": {
    "codex-token-trace": "./dist/cli.js",
    "ctt": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fix": "npm run format && npm run lint:fix",
    "verify": "node scripts/verify.mjs",
    "check": "npm run verify"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "hono": "^4.12.9"
  }
}
