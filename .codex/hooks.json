{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/git-status-start.sh\"",
            "timeout": 10,
            "statusMessage": "Recording initial git status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_gate.py\"",
            "timeout": 600,
            "statusMessage": "Running final verification"
          }
        ]
      }
    ]
  }
}
